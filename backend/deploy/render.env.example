SPRING_PROFILES_ACTIVE=prod
FRONTEND_BASE_URL=https://www.example.com
# Set these to your Supabase project values, or wire a render postgres database
# and use the credentials auto-injected by render.yaml.
DB_URL=jdbc:postgresql://<project>.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-supabase-db-password
DB_DRIVER=org.postgresql.Driver
DB_POOL_MAX=10
DB_POOL_MIN=2
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_PUBLIC_BUCKET=nlc-public
SUPABASE_PRIVATE_BUCKET=nlc-private
SUPABASE_SIGNED_URL_TTL=300
APP_STORAGE_PROVIDER=SUPABASE
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
BOOKING_EMAIL_ENABLED=false
INSTAGRAM_SYNC_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_SYNC_CRON=0 0 */6 * * *
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_ADMIN_RECIPIENT_NUMBER=
