# =============================================
# Nagpur Ladies Club — Backend environment
# Copy to `.env` and fill in real values.
# NEVER commit real secrets.
# =============================================

# ---------- Database (Supabase PostgreSQL) ----------
# Use the Supabase "Direct connection" or "Transaction pooler" JDBC URL.
# Example transaction-pooler: jdbc:postgresql://<project>.pooler.supabase.com:6543/postgres
DB_URL=jdbc:postgresql://<project>.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-supabase-db-password
DB_DRIVER=org.postgresql.Driver

# Optional HikariCP tuning (defaults shown in application.yml)
DB_POOL_MAX=10
DB_POOL_MIN=2

# ---------- JWT (Spring Security) ----------
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-at-least-32-bytes

# ---------- Supabase Storage ----------
# Supabase project URL (no trailing slash), e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://<project>.supabase.co
# Service-role key (NEVER expose to frontend; lives in backend only)
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
# Bucket names configured in Supabase Storage
SUPABASE_PUBLIC_BUCKET=nlc-public
SUPABASE_PRIVATE_BUCKET=nlc-private
SUPABASE_SIGNED_URL_TTL=300

# Storage provider — SUPABASE (default) or CLOUDINARY
# Set to CLOUDINARY to use Cloudinary for public media (gallery, events,
# members, sponsors). When CLOUDINARY is selected, the three credentials
# below MUST be set or the admin upload endpoint will respond with a
# clear 503 JSON error and the public site will keep working.
APP_STORAGE_PROVIDER=SUPABASE

# ---------- Cloudinary (only required when APP_STORAGE_PROVIDER=CLOUDINARY) ----------
# Cloud name from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
# API key and secret — these MUST stay on the backend only. Never expose
# CLOUDINARY_API_SECRET to the frontend.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder overrides (defaults shown).
CLOUDINARY_BASE_FOLDER=nlc
CLOUDINARY_GALLERY_FOLDER=nlc/gallery
CLOUDINARY_EVENTS_FOLDER=nlc/events
CLOUDINARY_MEMBERS_FOLDER=nlc/members
CLOUDINARY_SPONSORS_FOLDER=nlc/sponsors
CLOUDINARY_MAX_BYTES=10485760

# ---------- Frontend base URL (CORS) ----------
FRONTEND_BASE_URL=http://localhost:5173

# ---------- Mail (optional) ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=replace-with-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
BOOKING_EMAIL_ENABLED=false

# ---------- Instagram (optional, NEEDS EXTERNAL CONFIG) ----------
INSTAGRAM_SYNC_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_SYNC_CRON=0 0 */6 * * *

# ---------- WhatsApp (optional, NEEDS EXTERNAL CONFIG) ----------
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_ADMIN_RECIPIENT_NUMBER=
