{
  "info": {
    "name": "NLC Event Management Backend",
    "_postman_id": "0d3a6f6d-4cc5-4c6c-b6b4-1d5f43e9b123",
    "description": "Starter Postman collection for the Spring Boot backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"password\": \"Password@123\",\n  \"city\": \"Nagpur\",\n  \"profession\": \"Entrepreneur\",\n  \"instagramProfile\": \"https://instagram.com/demo\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@nlc.local\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "Public - Events",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/public/events?page=0&size=10"
      }
    },
    {
      "name": "User - Create Booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/user/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": 1,\n  \"quantity\": 2,\n  \"attendeeNotes\": \"Front row if available\"\n}"
        }
      }
    },
    {
      "name": "Admin - Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/admin/dashboard"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "accessToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ]
}
